<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= config.title %></title>
  <meta name="description" content="<%= config.description %>">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="access">
    <div class="brand"><%= config.brand %></div>
    <h1><%= config.access_title %></h1>
    <p class="msg"><%= config.access_message %></p>
    <a class="cta" href="<%= config.pikpak_url %>" target="_blank" rel="noopener sponsored"><%= config.cta_text %> →</a>
    <footer>
      <p>© <%= new Date().getFullYear() %> <%= config.brand %>. Promotional landing page.</p>
    </footer>
  </div>
</body>
</html>
