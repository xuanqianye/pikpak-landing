<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= config.title %></title>
  <meta name="description" content="<%= config.description %>">
  <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= Date.now() %>">
</head>
<body>
  <div class="access">
    <h1><%= config.brand %></h1>
    <p class="msg"><%= config.access_message %></p>
    <p class="msg"><%= config.access_message2 %></p>
    <a class="cta" href="<%= config.pikpak_url %>" target="_blank" rel="noopener sponsored"><%= config.cta_text %> →</a>
    <div class="counter">Total visits: <span id="visit-count">—</span></div>
    <div class="contact">Contact Us: <a href="mailto:feetworld2026@outlook.com">✉︎ feetworld2026@outlook.com</a></div>
    <script>
      (function () {
        var el = document.getElementById('visit-count');
        var dayKey = 'fw_visit_' + new Date().toISOString().slice(0, 10);
        function show(n) { el.textContent = Number(n).toLocaleString(); }
        var post = !localStorage.getItem(dayKey);
        if (post) localStorage.setItem(dayKey, '1');
        fetch('/api/visitor-count', { method: post ? 'POST' : 'GET' })
          .then(function (r) { return r.json(); })
          .then(function (d) { if (typeof d.count === 'number') show(d.count); else el.textContent = '—'; })
          .catch(function () { el.textContent = '—'; });
      })();
    </script>
  </div>
</body>
</html>
